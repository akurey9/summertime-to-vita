+++ b/compile_modules_vita.sh
@@ -0,0 +1,49 @@
+#!/bin/sh
+# Packs the installed CPython 3.12 stdlib into lib/python312.zip
+# (optimized bytecode only) and copies it into VitaSDK.
+#
+# Usage: ./compile_modules_vita.sh [DESTDIR]   (same DESTDIR as build_vita.sh)
+set -e
+
+printf '\033[1;32mCompiling Python Modules\033[0m\n'
+
+if [ -z "$1" ]; then
+    PREFIX=$VITASDK/arm-vita-eabi
+else
+    PREFIX=$1/$VITASDK/arm-vita-eabi
+fi
+export PREFIX
+
+BUILD_PYTHON=${BUILD_PYTHON:-python3.12}
+PYTHON_BUILD=python312-vita-build
+
+mkdir -p "$PYTHON_BUILD"
+rm -f "$PYTHON_BUILD/python312.zip"
+rm -rf "$PYTHON_BUILD/python3.12"
+cp -as "$PREFIX/lib/python3.12" "$PYTHON_BUILD"
+cd "$PYTHON_BUILD/python3.12"
+
+# Tests, tools, and modules whose C side isn't built for the Vita.
+rm -rf test idlelib tkinter turtledemo turtle.py ensurepip lib2to3 \
+       pydoc_data venv sqlite3 curses dbm \
+       config-3.12-* site-packages __phello__ __hello__.py
+find . -type d -name __pycache__ -prune -exec rm -rf {} +
+
+find . -type l -not -name '*.py' -delete
+find . -type d -empty -delete
+"$BUILD_PYTHON" -I -OO -m compileall -q -b .
+find . -type l -not -name '*.pyc' -delete
+find . -type d -empty -delete
+
+"$BUILD_PYTHON" - ../python312.zip <<'EOF'
+import os, sys, zipfile
+with zipfile.ZipFile(sys.argv[1], "w", zipfile.ZIP_DEFLATED) as z:
+    for root, dirs, files in os.walk("."):
+        dirs.sort()
+        for name in sorted(files):
+            path = os.path.join(root, name)
+            z.write(path, os.path.relpath(path, "."))
+EOF
+cd ..
+cp python312.zip "$PREFIX/lib/"
+echo "Installed $PREFIX/lib/python312.zip"
