         root = _os._path_splitroot(path)[0].replace('/', '\\')
         return len(root) > 1 and (root.startswith('\\\\') or root.endswith('\\'))
 
+elif _VITA:
+    def _path_isabs(path):
+        """Replacement for os.path.isabs: Vita paths are absolute when
+        they start with a device prefix such as 'ux0:' or 'app0:'."""
