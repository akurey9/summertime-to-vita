diff --git a/sample/main.c b/sample/main.c
new file mode 100644
index 0000000..22dc744
--- /dev/null
+++ b/sample/main.c
@@ -0,0 +1,68 @@
+/*
+ * CPython 3.12 smoke test for the PlayStation Vita.
+ *
+ * Starts the interpreter the same way the Ren'Py launcher will (home is
+ * the app directory, stdlib in lib/python312.zip) and runs main.py, which
+ * checks the parts Ren'Py relies on.  Results go to stdout and to
+ * ux0:data/python312-test.txt.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <Python.h>
+#include <psp2/appmgr.h>
+#include <psp2/kernel/processmgr.h>
+
+int _newlib_heap_size_user = 100 * 1024 * 1024;
+/* The interpreter runs on the main thread, leave room for
+   C_RECURSION_LIMIT (1000) levels of C recursion. */
+unsigned int sceUserMainThreadStackSize = 2 * 1024 * 1024;
+
+#define APP_DIR "ux0:app/PYTH00312"
+
+static int fail(PyStatus status, PyConfig *config) {
+    PyConfig_Clear(config);
+    if (PyStatus_IsExit(status)) {
+        return status.exitcode;
+    }
+    Py_ExitStatusException(status);
+    return 1;
+}
+
+int main(int argc, char *argv[]) {
+    (void)argc;
+    (void)argv;
+
+    sceAppMgrUmount("app0:");
+
+    PyStatus status;
+    PyConfig config;
+    PyConfig_InitPythonConfig(&config);
+
+    config.site_import = 0;
+    config.optimization_level = 2;
+    config.write_bytecode = 0;
+    config.user_site_directory = 0;
+    config.buffered_stdio = 0;
+
+    status = PyConfig_SetBytesString(&config, &config.home, APP_DIR);
+    if (PyStatus_Exception(status)) return fail(status, &config);
+
+    status = PyConfig_SetBytesString(&config, &config.program_name, APP_DIR "/eboot.bin");
+    if (PyStatus_Exception(status)) return fail(status, &config);
+
+    status = Py_InitializeFromConfig(&config);
+    if (PyStatus_Exception(status)) return fail(status, &config);
+    PyConfig_Clear(&config);
+
+    FILE *fp = fopen(APP_DIR "/main.py", "r");
+    if (fp == NULL) {
+        printf("Could not open main.py\n");
+        Py_Finalize();
+        return 1;
+    }
+
+    int rc = PyRun_SimpleFileEx(fp, APP_DIR "/main.py", 1);
+    Py_Finalize();
+    sceKernelExitProcess(rc);
+    return rc;
+}
diff --git a/sample/main.py b/sample/main.py
new file mode 100644
index 0000000..d46bd38
--- /dev/null
+++ b/sample/main.py
@@ -0,0 +1,122 @@
+# CPython 3.12 Vita smoke test.  Runs the things Ren'Py needs from the
+# interpreter, prints PASS/FAIL for each and writes the results to
+# ux0:data/python312-test.txt so they can be read without a console.
+
+import sys
+import traceback
+
+results = []
+
+
+def check(name):
+    def wrap(fn):
+        try:
+            detail = fn()
+            results.append("PASS %s%s" % (name, (": %s" % detail) if detail else ""))
+        except Exception:
+            results.append("FAIL %s\n%s" % (name, traceback.format_exc()))
+        print(results[-1])
+        return fn
+    return wrap
+
+
+@check("platform")
+def _():
+    import os
+    assert sys.platform == "vita", sys.platform
+    assert os.name == "posix", os.name
+    assert os.path.__name__ == "vitapath", os.path.__name__
+    return "%s, %s" % (sys.version.split()[0], sys.path)
+
+
+@check("vitapath")
+def _():
+    import os.path as p
+    assert p.isabs("ux0:/data") and not p.isabs("data/x")
+    assert p.join("ux0:/data", "a", "b.txt") == "ux0:/data/a/b.txt"
+    assert p.normpath("ux0:/data/../app/./x") == "ux0:/app/x"
+    assert p.dirname("ux0:/data/x.txt") == "ux0:/data"
+    assert p.splitroot("ux0:/data/x") == ("ux0:", "/", "data/x")
+
+
+@check("pathlib")
+def _():
+    from pathlib import PurePath
+    pp = PurePath("ux0:/data/game/script.rpy")
+    assert pp.is_absolute(), pp
+    assert pp.name == "script.rpy" and pp.suffix == ".rpy"
+    assert str(pp.parent) == "ux0:/data/game", str(pp.parent)
+
+
+@check("file io")
+def _():
+    import os
+    os.makedirs("ux0:data/python312-tmp", exist_ok=True)
+    fn = "ux0:data/python312-tmp/test.bin"
+    with open(fn, "wb") as f:
+        f.write(b"x" * 100000)
+    assert os.path.getsize(fn) == 100000
+    names = os.listdir("ux0:data/python312-tmp")
+    entries = [e.name for e in os.scandir("ux0:data/python312-tmp")]
+    os.replace(fn, fn + ".2")
+    os.remove(fn + ".2")
+    os.rmdir("ux0:data/python312-tmp")
+    return "%s %s" % (names, entries)
+
+
+@check("stdlib modules")
+def _():
+    import array, binascii, bisect, collections, datetime, functools, hashlib
+    import heapq, io, itertools, json, math, pickle, queue, random, re
+    import struct, threading, time, unicodedata, weakref, zlib, zipfile
+    hashlib.md5(b"a").hexdigest()
+    hashlib.sha256(b"a").hexdigest()
+    hashlib.blake2b(b"a").hexdigest()
+    assert zlib.decompress(zlib.compress(b"renpy" * 100)) == b"renpy" * 100
+    assert unicodedata.category("a") == "Ll"
+    return time.strftime("%Y-%m-%d %H:%M:%S", time.localtime())
+
+
+@check("deep pickle on a thread")
+def _():
+    # Ren'Py autosaves from a background thread, so this has to fit in the
+    # 1 MiB thread stack with the Vita's C_RECURSION_LIMIT of 1000.
+    import pickle, threading
+    out = {}
+
+    def work():
+        node = None
+        for i in range(400):
+            node = [i, node]
+        out["size"] = len(pickle.dumps(node, protocol=pickle.HIGHEST_PROTOCOL))
+        deeper = None
+        for i in range(5000):
+            deeper = [deeper]
+        try:
+            pickle.dumps(deeper)
+            out["deep"] = "no error"
+        except RecursionError:
+            out["deep"] = "RecursionError (expected)"
+
+    t = threading.Thread(target=work)
+    t.start()
+    t.join()
+    assert "size" in out, "thread crashed"
+    return "%d bytes, %s" % (out["size"], out["deep"])
+
+
+@check("zipimport")
+def _():
+    import zipimport
+    assert any(p.endswith(".zip") for p in sys.path), sys.path
+
+
+try:
+    with open("ux0:data/python312-test.txt", "w") as f:
+        f.write("\n".join(results) + "\n")
+except Exception:
+    traceback.print_exc()
+
+failed = sum(1 for r in results if r.startswith("FAIL"))
+print("%d checks, %d failed" % (len(results), failed))
+sys.exit(1 if failed else 0)
