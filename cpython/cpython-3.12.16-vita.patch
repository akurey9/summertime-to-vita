+# configure presets for the PlayStation Vita (arm-vita-eabi), CPython 3.12.
+# Used by build_vita.sh via CONFIG_SITE=config.site.
+
+# Cross-compiling: configure cannot probe the target's /dev.
+ac_cv_file__dev_ptmx=no
+ac_cv_file__dev_ptc=no
+
+# VitaSDK newlib declares some functions without prototypes, and leaves
+# some results unused; don't turn those into hard errors.
+ac_cv_enable_implicit_function_declaration_error=no
+ac_cv_disable_unused_result_warning=no
+
+# sys/resource.h exists but getrusage/setrlimit are not implemented.
+ac_cv_header_sys_resource_h=no
+
+# Found by the link test, but declared in sys/resource.h (disabled above),
+# and newer GCC rejects calls without a prototype.
+ac_cv_func_getpriority=no
+ac_cv_func_setpriority=no
+
+# Link every stdlib extension module into libpython3.12.a, the Vita can't
+# load shared objects.  (configure.ac: MODULE_BUILDTYPE=${MODULE_BUILDTYPE:-shared})
+MODULE_BUILDTYPE=static
+
+# Modules that can't work on the Vita (no processes, users, terminals,
+# dlopen/libffi or subinterpreters) or that Ren'Py never touches.
+# PY_STDLIB_MOD skips anything whose py_cv_module_* is already "n/a".
+py_cv_module__multiprocessing=n/a
+py_cv_module__posixsubprocess=n/a
+py_cv_module__posixshmem=n/a
+py_cv_module__ctypes=n/a
+py_cv_module__ctypes_test=n/a
+py_cv_module__crypt=n/a
+py_cv_module__curses=n/a
+py_cv_module__curses_panel=n/a
+py_cv_module__dbm=n/a
+py_cv_module__gdbm=n/a
+py_cv_module__lzma=n/a
+py_cv_module__bz2=n/a
+py_cv_module__scproxy=n/a
+py_cv_module__sqlite3=n/a
+py_cv_module__tkinter=n/a
+py_cv_module__uuid=n/a
+py_cv_module__xxsubinterpreters=n/a
+py_cv_module__xxinterpchannels=n/a
+py_cv_module__elementtree=n/a
+py_cv_module_pyexpat=n/a
+py_cv_module_grp=n/a
+py_cv_module_pwd=n/a
+py_cv_module_mmap=n/a
+py_cv_module_nis=n/a
+py_cv_module_ossaudiodev=n/a
+py_cv_module_readline=n/a
+py_cv_module_resource=n/a
